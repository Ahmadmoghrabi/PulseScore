# Xcode project is generated by XcodeGen from project.yml — the source of
# truth lives there, not in this generated, merge-conflict-prone XML.
# Run `xcodegen generate` after cloning to recreate it.
*.xcodeproj/

# Build artifacts
build/
DerivedData/
*.hmap
*.ipa

# Xcode per-user state (schemes/breakpoints/window layout — not shared)
xcuserdata/
*.xcuserstate

# Swift Package Manager
.swiftpm/
.build/

# macOS
.DS_Store
